%% isof-code.sty
%% Code: tinted full-width panels, no frame, small monospace.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{isof-code}[2026/10/16 ISOF Code Styling]

\RequirePackage{isof-colors}
\RequirePackage{fancyvrb}
\RequirePackage[most]{tcolorbox}

\fvset{fontsize=\small, formatcom=\color{ink}, baselinestretch=1.05}

\newtcolorbox{isofcodepanel}{%
    enhanced, breakable,
    colback=codebg, colframe=codebg, boxrule=0pt, arc=0pt,
    left=10pt, right=10pt, top=7pt, bottom=1pt,
    before skip=10pt, after skip=12pt,
    before upper={\setlength{\parskip}{0pt}\setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}},
    after upper={\par\unskip}
}

% Every Verbatim block sits in a panel
\BeforeBeginEnvironment{Verbatim}{\begin{isofcodepanel}}
\AfterEndEnvironment{Verbatim}{\end{isofcodepanel}}

% Named code block environment
\DefineVerbatimEnvironment{code}{Verbatim}{}

% Inline code
\newcommand{\inlinecode}[1]{\texttt{#1}}

\endinput
