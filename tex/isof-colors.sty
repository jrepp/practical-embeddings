%% isof-colors.sty
%% Color palette: near-black ink, one accent, and two tints.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{isof-colors}[2026/10/16 ISOF Color Definitions]

\RequirePackage{xcolor}

% Ink and accent
\definecolor{ink}{RGB}{28,28,28}
\definecolor{accent}{RGB}{214,64,36}
\definecolor{accentdark}{RGB}{160,40,20}

% Gray scale
\definecolor{darkgray}{RGB}{51,51,51}
\definecolor{medgray}{RGB}{110,110,110}
\definecolor{rulegray}{RGB}{200,200,200}
\definecolor{lightgray}{RGB}{244,242,238}

% Backgrounds
\definecolor{codebg}{RGB}{244,242,238}
\definecolor{notebg}{RGB}{252,240,232}
\definecolor{tipbg}{RGB}{236,244,238}

% Older names, kept for any source that still uses them
\colorlet{primarycolor}{accent}
\colorlet{isofblue}{accent}

\endinput
